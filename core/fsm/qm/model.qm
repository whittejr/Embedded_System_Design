<?xml version="1.0" encoding="UTF-8"?>
<model version="7.0.3" links="0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.state-machine.com/qm/qm7.xsd">
 <framework name="qpc"/>
 <package name="HSMs" stereotype="0x02">
  <class name="Clock_Alarm" superclass="qpc::QHsm">
   <attribute name="curr_time" type="uint32_t" visibility="0x02" properties="0x01"/>
   <attribute name="temp_time" type="uint8_t" visibility="0x02" properties="0x00"/>
   <attribute name="alarm_time" type="uint32_t" visibility="0x02" properties="0x00"/>
   <attribute name="alarm_status" type="uint8_t" visibility="0x02" properties="0x00"/>
   <attribute name="time_mode" type="uint8_t" visibility="0x02" properties="0x00"/>
   <attribute name="obj" type="Clock_Alarm" visibility="0x02" properties="0x01"/>
   <operation name="get_curr_time" type="uint32_t" visibility="0x00" properties="0x01">
    <documentation>Returns the value of curr_time </documentation>
   </operation>
   <operation name="update_curr_time" type="void" visibility="0x00" properties="0x01">
    <code>if(++Clock_Alarm_curr_time == MAX_TIME) {
    Clock_Alarm_curr_time = 0;
} </code>
   </operation>
   <statechart properties="0x00">
    <initial target="../1/2">
     <initial_glyph conn="9,13,5,3,17,34,6">
      <action box="0,-2,10,2"/>
     </initial_glyph>
    </initial>
    <state name="Clock">
     <history type="deep" target="../2">
      <history_glyph conn="21,77,3,2,20,-11"/>
     </history>
     <tran trig="ALARM" target="../../2">
      <tran_glyph conn="39,107,2,0,6">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <state name="Ticking">
      <tran trig="SET" target="../../3/2">
       <tran_glyph conn="77,38,1,3,30">
        <action box="0,-2,10,2"/>
       </tran_glyph>
      </tran>
      <tran trig="OK" target="../../3/3">
       <tran_glyph conn="77,58,1,3,16,16,14">
        <action box="0,-2,10,2"/>
       </tran_glyph>
      </tran>
      <state_glyph node="32,35,45,31"/>
     </state>
     <state name="Settings">
      <tran trig="ABRT" target="../../2">
       <tran_glyph conn="89,81,3,2,-18,-15">
        <action box="0,-2,10,2"/>
       </tran_glyph>
      </tran>
      <tran trig="OK" target="../../2">
       <tran_glyph conn="89,88,3,2,-28,-22">
        <action box="0,-2,10,2"/>
       </tran_glyph>
      </tran>
      <state name="Clock_Setting">
       <state_glyph node="107,25,45,31"/>
      </state>
      <state name="Alarm_Setting">
       <state_glyph node="107,62,45,31"/>
      </state>
      <state_glyph node="89,12,77,90"/>
     </state>
     <state_glyph node="21,3,156,104"/>
    </state>
    <state name="Alarm_Notify">
     <tran trig="OK" target="../../1" cpref="../../1/0">
      <tran_glyph conn="23,120,3,3,-7,-43,4">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="23,113,33,20"/>
    </state>
    <state_diagram size="259,160"/>
   </statechart>
  </class>
  <directory name="./src">
   <file name="ClockAlarm_SM.c">
    <text>#include &quot;qpc.h&quot;
#include &quot;bsp.h&quot; // display
#include &quot;ClockAlarm_SM.h&quot;
$declare${HSMs::Clock_Alarm}
$define${HSMs::Clock_Alarm}</text>
   </file>
   <file name="ClockAlarm_SM.h">
    <text>#ifndef CLOCK_ALARM_H
#define CLOCK_ALARM_H

enum Clock_Alarm_Signals {
    SET_SIG = Q_USER_SIG,
    OK_SIG,
    ABRT_SIG,
    ALARM_SIG,
    TICK_SIG,
    MAX_SIG
};

#define MAX_TIME (864000UL) // 24 * 3600 * 10 

$define${HSMs::Clock_Alarm_ctor}

#endif</text>
   </file>
  </directory>
  <operation name="Clock_Alarm_ctor" type="void" visibility="0x00" properties="0x00">
   <code>QHsm_ctor(&amp;Clock_Alarm_obj.super, Q_STATE_CAST(&amp;Clock_Alarm_initial));</code>
  </operation>
 </package>
</model>
