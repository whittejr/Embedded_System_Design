    <state name="Alarm_Notify">
     <initial target="../3">
      <initial_glyph conn="33,142,5,2,3,-3">
       <action box="0,-2,10,2"/>
      </initial_glyph>
     </initial>
     <tran trig="OK" target="../../1" cpref="../../1/0">
      <tran_glyph conn="24,125,3,3,-7,-49,3">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <tran trig="TICK">
      <action>Clock_Alarm_display_curr_time(me, TICKING_CURR_TIME_ROW, TICKING_CURR_TIME_COL);</action>
      <choice>
       <guard>++me-&gt;alarm_timeout &gt;= 200U</guard>
